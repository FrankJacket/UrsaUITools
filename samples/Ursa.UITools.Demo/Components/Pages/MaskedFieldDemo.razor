@page "/masked-field"
@using System.Globalization

<PageTitle>Masked field</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">UrsaMaskedField</MudText>
<MudText Class="mb-4">
    A text field whose input mask runs in the browser: the server only receives the value on blur, on Enter, or when the mask is
    complete, so typing never lags or loses the caret, even in Interactive Server mode. <b>0</b> is a digit, <b>a</b> a letter,
    <b>*</b> anything; the other characters are inserted for you. Typing in the middle of a value overwrites, and Backspace or Delete
    in the middle only move over the character.
</MudText>

<MudText Class="mb-4">
    <b>MaskType</b> picks a ready-made format and its validation: set it and the mask, the pattern and the error message are filled in.
    Anything you set explicitly (<b>Mask</b>, <b>Pattern</b>, <b>PatternError</b>, <b>UpperCase</b>) wins over the preset.
</MudText>

<MudGrid>
    <MudItem xs="12" md="4">
        <UrsaMaskedField @bind-Value="_phone" MaskType="UrsaMaskType.PhoneNorthAmerica" Label="Phone (North America)" Placeholder="(514) 555-0123" Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption">Value: @(_phone ?? "(none)")</MudText>
    </MudItem>
    <MudItem xs="12" md="4">
        <UrsaMaskedField @bind-Value="_phoneEu" MaskType="UrsaMaskType.PhoneEurope" Label="Phone (Europe)" Placeholder="+33 1 23 45 67 89" Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption">Value: @(_phoneEu ?? "(none)")</MudText>
    </MudItem>
    <MudItem xs="12" md="4">
        <UrsaMaskedField @bind-Value="_postal" MaskType="UrsaMaskType.PostalCodeCanada" Label="Postal code (Canada)" Placeholder="H2X 1Y4" Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption">Value: @(_postal ?? "(none)")</MudText>
    </MudItem>
    <MudItem xs="12" md="4">
        <UrsaMaskedField @bind-Value="_zip" MaskType="UrsaMaskType.ZipCodeUS" Label="ZIP code (United States)" Placeholder="90210" Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption">Value: @(_zip ?? "(none)")</MudText>
    </MudItem>
    <MudItem xs="12" md="4">
        <UrsaMaskedField @bind-Value="_email" MaskType="UrsaMaskType.Email" Label="Email" Placeholder="name@example.com" Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption">Value: @(_email ?? "(none)")</MudText>
    </MudItem>
    <MudItem xs="12" md="4">
        <UrsaMaskedField @bind-Value="_dateType" MaskType="UrsaMaskType.Date" Label="@($"Date ({CultureInfo.CurrentCulture.Name})")" Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption">Value: @(_dateType ?? "(none)")</MudText>
    </MudItem>
    <MudItem xs="12" md="4">
        <UrsaMaskedField @bind-Value="_dateTimeType" MaskType="UrsaMaskType.DateTime" Label="@($"Date and time ({CultureInfo.CurrentCulture.Name})")" Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption">Value: @(_dateTimeType ?? "(none)")</MudText>
    </MudItem>
    <MudItem xs="12" md="4">
        <UrsaMaskedField @bind-Value="_override" MaskType="UrsaMaskType.PostalCodeCanada" PatternError="Please enter a Canadian postal code"
                         Label="Preset with an overridden error" Placeholder="H2X 1Y4" Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption">Value: @(_override ?? "(none)")</MudText>
    </MudItem>
    <MudItem xs="12" md="4">
        <UrsaMaskedField @bind-Value="_dateText" Mask="@UrsaMasks.Date(CultureInfo.CurrentCulture)" Validator="ValidateDate"
                         CommitOn="UrsaMaskCommit.Complete" Label="@($"Date ({CultureInfo.CurrentCulture.Name}, committed when complete)")"
                         Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption">Value: @(_dateText ?? "(none)")</MudText>
    </MudItem>
    <MudItem xs="12" md="4">
        <UrsaMaskedField @bind-Value="_dateTimeText" Mask="@UrsaMasks.Date(CultureInfo.CurrentCulture, withTime: true)" Validator="ValidateDateTime"
                         Label="Date and time" Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption">Value: @(_dateTimeText ?? "(none)")</MudText>
    </MudItem>
    <MudItem xs="12" md="4">
        <UrsaMaskedField @bind-Value="_iso" Mask="0000-00-00" Label="ISO date (yyyy-MM-dd), prefilled" Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption">Value: @(_iso ?? "(none)")</MudText>
    </MudItem>
</MudGrid>

@code {
    private string? _phone;
    private string? _phoneEu;
    private string? _postal;
    private string? _zip;
    private string? _email;
    private string? _dateType;
    private string? _dateTimeType;
    private string? _override;
    private string? _dateText;
    private string? _dateTimeText;
    private string? _iso = "2027-11-14";

    private static string? ValidateDate(string text) => Validate(text, UrsaMasks.DateFormat(CultureInfo.CurrentCulture));

    private static string? ValidateDateTime(string text) => Validate(text, UrsaMasks.DateFormat(CultureInfo.CurrentCulture, withTime: true));

    private static string? Validate(string text, string? format) =>
        format is not null && DateTime.TryParseExact(text, format, CultureInfo.CurrentCulture, DateTimeStyles.None, out _)
            ? null
            : "Not a valid date";
}
