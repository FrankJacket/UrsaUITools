@page "/date-picker"
@using System.Globalization

<PageTitle>Date picker</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">UrsaDatePicker</MudText>
<MudText Class="mb-4">
    A MudDatePicker you can type in by default, without an input mask: nothing is sent to the server while you type. When you leave the
    field, free-form input is read and shown in the culture's format: <b>20260102</b>, <b>260102</b>, <b>2026/1/2</b> or <b>2026.01.02</b>
    all become the same date, and a date that does not exist is refused. It can also edit the time of day, by typing or with a time
    picker, and the calendar has a "Today" button. Formats follow the culture of the session
    (<b>@CultureInfo.CurrentCulture.Name</b>, from the browser language).
</MudText>

<MudSelect T="string" @bind-Value="_cultureName" Label="Culture (override for this demo)" Variant="Variant.Outlined" Class="mb-6" Style="max-width: 360px">
    <MudSelectItem Value="@("")">Session culture (@CultureInfo.CurrentCulture.Name)</MudSelectItem>
    @foreach (var name in Cultures)
    {
        <MudSelectItem Value="@name">@name</MudSelectItem>
    }
</MudSelect>

<MudGrid>
    <MudItem xs="12" md="4">
        <UrsaDatePicker @bind-Date="_date" Culture="Culture" Label="Date" Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption">Value: @_date?.ToString("O")</MudText>
    </MudItem>
    <MudItem xs="12" md="4">
        <UrsaDatePicker @bind-Date="_dateTime" Culture="Culture" ShowTime="true" Label="Date and time (typed)" Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption">Value: @_dateTime?.ToString("O")</MudText>
    </MudItem>
    <MudItem xs="12" md="4">
        <UrsaDatePicker @bind-Date="_dateTimePick" Culture="Culture" ShowTimePicker="true" Label="Date and time (picker)" Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption">Value: @_dateTimePick?.ToString("O")</MudText>
    </MudItem>
    <MudItem xs="12" md="4">
        <UrsaDatePicker @bind-Date="_dateRange" Culture="Culture" MinDate="@(new DateTime(2026, 1, 1))" MaxDate="@(new DateTime(2026, 12, 31))"
                        Label="Only in 2026 (MinDate and MaxDate)" Variant="Variant.Outlined" />
        <MudText Typo="Typo.caption">Value: @_dateRange?.ToString("O")</MudText>
    </MudItem>
</MudGrid>

@code {
    private static readonly string[] Cultures = ["en-US", "en-GB", "fr-CA", "fr-FR", "de-DE", "ja-JP"];

    private string _cultureName = "";
    private DateTime? _date;
    private DateTime? _dateTime = new(2026, 11, 14, 13, 45, 0);
    private DateTime? _dateTimePick;
    private DateTime? _dateRange;

    private CultureInfo Culture => string.IsNullOrEmpty(_cultureName) ? CultureInfo.CurrentCulture : CultureInfo.GetCultureInfo(_cultureName);
}
