<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>Ursa.UITools</PackageId>
    <Version>0.1.1</Version>
    <Authors>FrankJacket</Authors>
    <Description>Visual component extensions for MudBlazor.</Description>
    <PackageTags>blazor;mudblazor;components</PackageTags>
    <RepositoryUrl>https://github.com/FrankJacket/UrsaUITools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <InternalsVisibleTo Include="Ursa.UITools.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="MudBlazor" Version="9.13.0" />
    <PackageReference Include="ReverseMarkdown" Version="6.3.0" />
  </ItemGroup>

</Project>
