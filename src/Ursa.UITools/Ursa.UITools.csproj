<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <PackageId>Ursa.UITools</PackageId>
    <Description>Visual component extensions for MudBlazor.</Description>
    <RepositoryUrl>https://github.com/FrankJacket/UrsaUITools</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.13.0" />
  </ItemGroup>

</Project>
